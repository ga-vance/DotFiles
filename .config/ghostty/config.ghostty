# Theme
#theme = Catppuccin Mocha
theme = Rose Pine Moon
background-opacity = 0.95

# Fonts
font-family = Monaspace Krypton NF Wide Regular
font-size = 12

# Cursor
cursor-style = block
shell-integration-features = no-cursor
cursor-opacity = 0.95

# Window Size
window-width = 200
window-height = 50
